{
    "manifest_version": 3,
    "name": "BAXUS Price Checker",
    "version": "1.0",
    "description": "Compares whisky/wine prices on retail sites with BAXUS marketplace listings.",
    "permissions": [
      "activeTab", 
      "scripting", 
      "storage"    
    ],
    "host_permissions": [
      "https://api.firecrawl.dev/*",          
      "https://generativelanguage.googleapis.com/*", 
      "https://services.baxus.co/*"            
    ],
    "action": {
      "default_popup": "popup/popup.html",
      "default_icon": {
        "16": "icons/icon16.png"
      }
    },
    "background": {
      "service_worker": "background/background.js",
      "type": "module" 
    },
    "icons": {
      "16": "icons/icon16.png"
  }
}